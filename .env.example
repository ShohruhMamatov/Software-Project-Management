# Copy this file to .env and fill in real values. Never commit .env.

# ---------- PostgreSQL (used by docker-compose) ----------
POSTGRES_USER=lumi
POSTGRES_PASSWORD=change-me
POSTGRES_DB=lumi
POSTGRES_PORT=5432

# ---------- Backend ----------
# Inside docker-compose the host is "db"; from your laptop it is "localhost".
DATABASE_URL=postgresql+psycopg://lumi:change-me@localhost:5432/lumi
# Secret for signing JWT tokens. Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=60
# Fernet key for encrypting camera passwords.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CAMERA_ENC_KEY=change-me
# Folder where uploaded clips and snapshots are stored.
MEDIA_DIR=./media

# ---------- Edge agent ----------
BACKEND_URL=http://localhost:8000
STORE_API_KEY=change-me

# ---------- Alerts ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
